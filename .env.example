# SmartWatch Hub - Environment Configuration Example
# Copy this file to .env and update values for your environment

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smartwatch_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Site Configuration
SITE_NAME=SmartWatch Hub
SITE_URL=http://localhost/SMARTWATCHES/
CURRENCY=$

# Environment (development, staging, production)
ENVIRONMENT=development

# Security
SESSION_NAME=smartwatch_session
SESSION_LIFETIME=3600

# Email Configuration (Optional - for future use)
MAIL_FROM_EMAIL=noreply@smartwatchhub.local
MAIL_FROM_NAME=SmartWatch Hub

# Application Debug (Set to false in production)
DEBUG=true

# Deployment notes:
# - For production, set DEBUG to false
# - Use strong passwords for DB_PASS
# - Update SITE_URL to your actual domain
# - Configure proper SSL certificates
# - Store this .env file in a secure location
# - Never commit .env to version control (only .env.example should be committed)
